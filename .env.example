# ---- Public (exposed to the browser; never put secrets here) ----
# Canonical production origin, used for canonical URLs, Open Graph and sitemap.xml
VITE_SITE_URL=https://alphadentalmedia.com
# Lead form endpoint (same-origin serverless function by default)
VITE_LEAD_ENDPOINT=/api/lead

# ---- Server-only (read by api/lead.js; never prefixed with VITE_) ----
# Where validated leads are delivered (Zapier/Make/CRM/Slack webhook). Required in production.
LEAD_WEBHOOK_URL=
# Comma-separated origins allowed to POST leads
ALLOWED_ORIGINS=https://alphadentalmedia.com,https://www.alphadentalmedia.com
